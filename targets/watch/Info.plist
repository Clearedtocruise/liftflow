<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>NSHealthShareUsageDescription</key>
    <string>ONE MORE reads heart rate during workouts on your Watch.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>ONE MORE may save workout heart rate to Apple Health.</string>
    <key>NSMotionUsageDescription</key>
    <string>ONE MORE uses motion sensors to detect workout activity on your Watch.</string>
    <!-- Required for HKWorkoutSession to keep running on wrist-down; without it watchOS
         suspends the app mid-workout and haptics, heart rate and the rest timer all stop. -->
    <key>WKBackgroundModes</key>
    <array>
      <string>workout-processing</string>
    </array>
  </dict>
</plist>
