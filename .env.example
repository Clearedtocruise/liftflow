# Supabase (required)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API — use production URL for device builds (not localhost)
EXPO_PUBLIC_API_URL=https://liftflow-api.onrender.com

# Auth email redirects (defaults to EXPO_PUBLIC_API_URL/auth/*)
EXPO_PUBLIC_AUTH_CONFIRM_URL=https://liftflow-api.onrender.com/auth/confirm
EXPO_PUBLIC_AUTH_RESET_URL=https://liftflow-api.onrender.com/auth/reset-password

# Render (required for npm run deploy:render)
RENDER_API_KEY=
RENDER_OWNER_ID=

# Supabase Management API (optional — for configure:auth script)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=your-project-ref
# Required for npm run migrate:010 (applies gym type constraints)

# Backend only (Render env vars)
PORT=3000
OPENAI_API_KEY=sk-your-openai-api-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Strava OAuth (backend)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://liftflow-api.onrender.com/api/integrations/strava/callback

# Founder admin dashboard (backend — set on Render)
FOUNDER_ADMIN_KEY=your-long-random-founder-key

# RevenueCat (mobile — optional until IAP configured)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# EAS (optional — set after eas init)
EAS_PROJECT_ID=
EXPO_OWNER=
