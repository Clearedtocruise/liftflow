# Supabase (required)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API — use production URL for device builds (not localhost)
EXPO_PUBLIC_API_URL=https://liftflow-api.onrender.com

# Auth email redirects (defaults to EXPO_PUBLIC_API_URL/auth/*)
EXPO_PUBLIC_AUTH_CONFIRM_URL=https://liftflow-api.onrender.com/auth/confirm
EXPO_PUBLIC_AUTH_RESET_URL=https://liftflow-api.onrender.com/auth/reset-password

# Render (required for npm run deploy:render)
RENDER_API_KEY=
RENDER_OWNER_ID=

# Supabase Management API (optional — for configure:auth script)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=your-project-ref
# Required for npm run migrate:010 (applies gym type constraints)
# Option A: personal access token from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Option B: direct postgres (Settings → Database → connection string)
DATABASE_URL=
SUPABASE_DB_PASSWORD=

# Backend only (Render env vars)
PORT=3000
OPENAI_API_KEY=sk-your-openai-api-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Strava OAuth (backend)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://liftflow-api.onrender.com/api/integrations/strava/callback

# Founder admin dashboard (backend — set on Render)
FOUNDER_ADMIN_KEY=your-long-random-founder-key

# RevenueCat (mobile — required for TestFlight IAP)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Backend webhook auth (Render) — from RevenueCat → Integrations → Webhooks
REVENUECAT_WEBHOOK_SECRET=
# Set to 1 on Render only if Sprint 7.9 gate user must hit intelligence routes without Pro
SUBSCRIPTION_GATE_DISABLED=

# Sentry (Sprint 8.5 — optional until DSN configured)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
EXPO_PUBLIC_SENTRY_RELEASE=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
# EAS native build source map upload (Sprint 8.7 — never commit token)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# EAS (optional — set after eas init)
EAS_PROJECT_ID=
EXPO_OWNER=
