# Supabase (required)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API — use production URL for device builds (not localhost)
EXPO_PUBLIC_API_URL=https://liftflow-api.onrender.com

# Supabase Management API (optional — for configure:auth script)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=your-project-ref

# Backend only (Render env vars)
PORT=3000
OPENAI_API_KEY=sk-your-openai-api-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# EAS (optional — set after eas init)
EAS_PROJECT_ID=
EXPO_OWNER=
